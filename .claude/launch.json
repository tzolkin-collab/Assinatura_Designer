{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "backend",
      "port": 4000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "backend-local",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["cross-env", "PORT=4000", "CORS_ORIGIN=http://localhost:3000", "RUN_WORKER_IN_PROCESS=true", "ZOMBIE_POST_SWEEP_ENABLED=false", "BULLMQ_PREFIX=dev-local", "NODE_ENV=development", "tsx", "watch", "src/server.ts"],
      "cwd": "backend",
      "port": 4000
    }
  ]
}
