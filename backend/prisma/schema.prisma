generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String          @id @default(uuid())
  email              String          @unique
  password           String
  name               String
  role               Role            @default(DESIGNER)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  asanaToken         String?
  asanaRefreshToken  String?
  asanaTokenExpiry   DateTime?
  // Nonce + expiração do handshake OAuth do Asana (mesmo padrão do Canva) — o
  // `state = userId` cru antigo não provava que a request veio do auth-url nosso.
  asanaOauthState    String?
  asanaOauthStateAt  DateTime?
  googleAccessToken  String?
  googleRefreshToken String?
  googleTokenExpiry  DateTime?
  googleOauthState   String?
  googleOauthStateAt DateTime?
  canvaAccessToken   String?
  canvaRefreshToken  String?
  canvaTokenExpiry   DateTime?
  canvaUserId        String?
  // PKCE transitório do OAuth do Canva: gravados no auth-url, limpos no callback.
  canvaCodeVerifier  String?
  canvaOauthState    String?
  canvaOauthStateAt  DateTime?
  brandMemberships   BrandMember[]
  invitesSent        Invite[]        @relation("InvitesSent")
  assets             Asset[]
  notifications      Notification[]
  createdPosts       Post[]
  accessRequests     AccessRequest[]
  postVersions       PostVersion[]

  // Achamos o usuário pelo state no callback do OAuth — sem índice seria full scan.
  @@index([canvaOauthState])
  @@index([asanaOauthState])
  @@index([googleOauthState])
}

enum BrandRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model BrandMember {
  id        String    @id @default(uuid())
  role      BrandRole @default(EDITOR)
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([userId, brandId])
  @@index([brandId])
}

model Asset {
  id        String   @id @default(uuid())
  name      String
  url       String
  fileType  String
  sizeBytes Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // De onde o asset veio — filtro estratégico na biblioteca de mídia.
  source String   @default("upload") // upload | drive | asana | canva | ai-generated
  tags   String[] @default([])

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  uploadedBy String?
  user       User?   @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  // Post de origem quando o asset nasceu de uma geração (source='ai-generated').
  // SetNull: apagar o post não deve apagar o asset — a imagem continua útil na biblioteca.
  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([brandId])
  @@index([source])
  @@index([postId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  read      Boolean  @default(false)
  type      String   @default("INFO")
  link      String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Brand {
  id               String            @id @default(uuid())
  slug             String            @unique
  name             String
  color            String?           @default("#f0bfbf")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  config           BrandConfig?
  folders          Folder[]
  posts            Post[]
  refs             Reference[]
  members          BrandMember[]
  assets           Asset[]
  accessRequests   AccessRequest[]
  invites          Invite[]
}

model BrandConfig {
  id                 String   @id @default(uuid())
  agentPrompt        String
  primaryFonts       String[]
  colors             String[]
  guidelines         String
  logoUrl            String?
  updatedAt          DateTime @updatedAt
  brandId            String   @unique
  presentationConfig Json?
  // Pesquisa automática de benchmark é por marca (substitui o antigo toggle
  // por-referência em Reference.autoSyncEnabled/autoSyncInterval, mantidos no
  // schema mas sem leitor/escritor novo — ver benchmarkOrchestrator.ts).
  autoResearchEnabled  Boolean   @default(false)
  autoResearchInterval Int       @default(14)
  lastAutoResearchAt   DateTime?
  // Estado da sessão de "Configurar Benchmark" em andamento (descoberta →
  // pergunta pendente → confirmação → análise). Ver BenchmarkSession em
  // benchmarkOrchestrator.ts para o shape tipado em TS.
  benchmarkSession     Json?
  // Resumo consolidado (markdown) sintetizado a partir de TODAS as
  // referências ANALYZED — não a análise de 1 concorrente, mas o panorama:
  // padrões recorrentes, oportunidades de diferenciação, paleta/tom
  // recomendados. Vira contexto extra pro artista (ver brandContext.ts).
  benchmarkSummary     String?
  benchmarkSummaryUpdatedAt DateTime?
  brand              Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

model Reference {
  id           String     @id @default(uuid())
  name         String
  status       RefStatus  @default(PENDING)
  insights     Int        @default(0)
  insightsText String?
  analysisUrl  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  brandId      String
  archetype        String?
  density          String?
  imageUrl         String?
  markers          Json?
  palette          String[]
  sourceType       SourceType @default(WEBSITE)
  toneOfVoice      String?
  // DEPRECATED (2026-07): substituído por BrandConfig.autoResearchEnabled —
  // "Pesquisa automática" agora é por marca, não por referência. Mantidos
  // aqui porque já existem linhas reais com estes campos setados; sem
  // leitor/escritor a partir desta mudança (ver benchmarkOrchestrator.ts).
  autoSyncEnabled  Boolean    @default(false)
  autoSyncInterval Int        @default(14)
  lastSyncedAt     DateTime?
  // Todas as imagens coletadas (não só a capa/imageUrl) — bio+posts do
  // Instagram ou páginas do site, pra galeria completa na aba da referência.
  galleryImageUrls String[]   @default([])
  brand            Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
}

model Post {
  id             String     @id @default(uuid())
  name           String?    @db.VarChar(255)
  type           PostType
  status         PostStatus @default(DRAFT)
  content        Json?
  previewUrl     String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  brandId        String
  folderId       String?
  createdById    String?
  canvaDesignId  String?
  canvaExportUrl String?
  canvaDesignName String?
  canvaSyncEnabled Boolean    @default(false)
  canvaLastSyncedAt DateTime?
  // Hospedagem pública (Fase 5, Fatia 1 — navegação): slug curto e opaco pra URL
  // pública; publishedAt null = não hospedado (a checagem de "está publicado" é
  // sempre AND com publicSlug, nunca só um dos dois). hostingConfig guarda toggles
  // de apresentação (autoplay, contador) — nasce pronto pra formsEnabled/
  // liveSyncEnabled de fases futuras sem precisar de nova migration.
  publicSlug     String?    @unique
  publishedAt    DateTime?
  hostingConfig  Json?
  brand          Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  folder         Folder?    @relation(fields: [folderId], references: [id])
  createdBy      User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  slides         Slide[]
  versions       PostVersion[]
  generatedAssets Asset[]

  @@index([brandId])
  @@index([folderId])
  @@index([publicSlug])
}

/// De onde veio o snapshot. `AI` é o que mais importa: guarda o estado ANTES de a
/// IA escrever, que é o trabalho do usuário que estaria perdido sem isto.
enum VersionSource {
  MANUAL
  EDITOR
  AI
  RESTORE
}

/// Snapshot do conteúdo inteiro do post (slides re-hidratados), não de um slide
/// solto: restaurar meio deck deixaria o post incoerente.
///
/// `contentHash` existe para não gravar duas versões idênticas — o editor salva
/// direto, e sem isto o histórico viraria uma pilha de cópias iguais. Um deck de
/// 200 slides passa de 2MB de JSON, então o número de versões por post é limitado
/// (as mais antigas caem).
model PostVersion {
  id          String        @id @default(uuid())
  postId      String
  post        Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  content     Json
  contentHash String
  label       String?       @db.VarChar(160)
  source      VersionSource @default(EDITOR)
  slideCount  Int           @default(0)
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([postId, createdAt])
}

model Slide {
  id          String   @id @default(uuid())
  postId      String   @map("post_id")
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  contentJson Json     @map("content_json")
  htmlRender  String?  @map("html_render") @db.Text
  position    Int
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([postId])
  @@map("slides")
}

model Folder {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  posts     Post[]

  parentId  String?
  parent    Folder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderHierarchy")

  @@index([brandId])
}

model data_deletion_requests {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String?   @db.VarChar(255)
  contact      String    @db.VarChar(255)
  message      String?
  status       String?   @default("pending") @db.VarChar(50)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  processed_at DateTime? @db.Timestamptz(6)
}

model diagnostic_responses {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idempotency_key String    @unique @db.VarChar(255)
  profile_name    String    @db.VarChar(255)
  answers         Json
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)
  completed_at    DateTime? @db.Timestamptz(6)
}

enum Role {
  ADMIN
  DESIGNER
}

enum SourceType {
  WEBSITE
  INSTAGRAM
}

enum RefStatus {
  PENDING
  ANALYZED
  FAILED
}

enum PostType {
  CAROUSEL
  SINGLE_IMAGE
  PRESENTATION
}

enum PostStatus {
  DRAFT
  GENERATING
  READY
  FAILED
}

/// Convite de equipe. Guarda só o HASH do token (SHA-256) — o token cru existe
/// uma única vez, no link entregue a quem convida. Vazamento do banco não vira
/// tomada de conta, mesma lógica de hashear senha.
model Invite {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  email     String
  role      BrandRole @default(EDITOR)

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  invitedById String?
  invitedBy   User?   @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: SetNull)

  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([brandId])
  @@index([email])
}

model AccessRequest {
  id     String @id @default(uuid())
  status String @default("PENDING") // PENDING, APPROVED, REJECTED

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, brandId])
  @@index([brandId])
  @@index([userId])
}
