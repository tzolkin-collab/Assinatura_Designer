generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  password           String
  name               String
  role               Role      @default(DESIGNER)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  asanaToken         String?
  googleAccessToken  String?
  googleRefreshToken String?
  googleTokenExpiry  DateTime?
  brands             Brand[]
}

model Brand {
  id               String            @id @default(uuid())
  slug             String            @unique
  name             String
  color            String?           @default("#171717")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  config           BrandConfig?
  canvaIntegration CanvaIntegration?
  folders          Folder[]
  posts            Post[]
  refs             Reference[]
}

model BrandConfig {
  id                 String   @id @default(uuid())
  agentPrompt        String
  primaryFonts       String[]
  colors             String[]
  guidelines         String
  logoUrl            String?
  updatedAt          DateTime @updatedAt
  brandId            String   @unique
  presentationConfig Json?
  brand              Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

model CanvaIntegration {
  id                String   @id @default(uuid())
  canvaAccessToken  String
  canvaRefreshToken String
  canvaUserId       String?
  tokenExpiresAt    DateTime
  codeVerifier      String?
  oauthState        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  brandId           String   @unique
  brand             Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

model Reference {
  id           String     @id @default(uuid())
  name         String
  status       RefStatus  @default(PENDING)
  insights     Int        @default(0)
  insightsText String?
  analysisUrl  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  brandId      String
  archetype    String?
  density      String?
  imageUrl     String?
  markers      Json?
  palette      String[]
  sourceType   SourceType @default(WEBSITE)
  toneOfVoice  String?
  brand        Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
}

model Post {
  id             String     @id @default(uuid())
  type           PostType
  status         PostStatus @default(DRAFT)
  content        Json?
  previewUrl     String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  brandId        String
  folderId       String?
  canvaDesignId  String?
  canvaExportUrl String?
  brand          Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  folder         Folder?    @relation(fields: [folderId], references: [id])
}

model Folder {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  posts     Post[]
}

model data_deletion_requests {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String?   @db.VarChar(255)
  contact      String    @db.VarChar(255)
  message      String?
  status       String?   @default("pending") @db.VarChar(50)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  processed_at DateTime? @db.Timestamptz(6)
}

model diagnostic_responses {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  idempotency_key String    @unique @db.VarChar(255)
  profile_name    String    @db.VarChar(255)
  answers         Json
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)
  completed_at    DateTime? @db.Timestamptz(6)
}

enum Role {
  ADMIN
  DESIGNER
}

enum SourceType {
  WEBSITE
  INSTAGRAM
}

enum RefStatus {
  PENDING
  ANALYZED
  FAILED
}

enum PostType {
  CAROUSEL
  SINGLE_IMAGE
  ANIMATION
  PRESENTATION
}

enum PostStatus {
  DRAFT
  GENERATING
  READY
  FAILED
}
