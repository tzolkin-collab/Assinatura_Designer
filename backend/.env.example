PORT=4000
DATABASE_URL="postgresql://user:password@host:5432/assinatura"
JWT_SECRET="change-me-to-a-strong-secret"
CORS_ORIGIN="http://localhost:3000"
NODE_ENV="development"
GEMINI_API_KEY="your-gemini-api-key-here"
NANO_BANANA_API_KEY="your-nano-banana-gemini-api-key-here"
FAL_API_KEY="your-fal-api-key-here"

# Cloudflare R2
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-bucket-name"
R2_PUBLIC_URL="https://pub-<hash>.r2.dev"

# Canva Connect API (OAuth 2.0 + PKCE)
CANVA_CLIENT_ID="your-canva-client-id"
CANVA_CLIENT_SECRET="your-canva-client-secret"
CANVA_REDIRECT_URI="http://localhost:4000/api/canva/callback"
