# ─────────────────────────────────────────────────────────────────────────────
# Designer Assinatura — backend/.env
# Copie para .env e preencha. Obrigatórias em produção: JWT_SECRET,
# DATABASE_URL, GEMINI_API_KEY (o boot recusa subir sem elas; ver config.ts).
# ─────────────────────────────────────────────────────────────────────────────

# ── Servidor ──
PORT=4000
NODE_ENV=development
# Origem(ns) do frontend para CORS em produção (separe por vírgula).
# Em desenvolvimento QUALQUER origem é aceita (localhost e IP de rede).
CORS_ORIGIN=http://localhost:3000

# ── Banco (Postgres) ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/assinatura
# Usada pelo prisma migrate dev (schema drift); não é lida em runtime.
SHADOW_DATABASE_URL=

# ── Auth ──
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# ── Redis (sessões da Fábrica + filas BullMQ + rate limit + billing de IA) ──
REDIS_URL=redis://localhost:6379

# ── Gemini ──
GEMINI_API_KEY=
# Modelos por PAPEL (defaults em config.ts; sobrescreva individualmente):
# GEMINI_DESIGN_DOCUMENT_MODEL=gemini-3.1-pro-preview   # artist: gera/edita a arte
# GEMINI_BRAIN_MODEL=gemini-2.5-pro                     # brain: chat da Fábrica
# GEMINI_FAST_MODEL=gemini-2.5-flash                    # fast: planner/reviewer/pesquisa
# GEMINI_UTILITY_MODEL=gemini-2.5-flash-lite            # utility: tarefas mecânicas
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image             # image: fotos/cenas geradas (lib/imageResolver.ts)
# GEMINI_IMAGE_FALLBACK_MODEL=gemini-3-pro-image        # imageFallback: se o primario falhar
# Teto de tokens de "thinking" na geração (-1 = dinâmico, 0 = sem thinking).
# GEMINI_THINKING_BUDGET=12288

# ── Cérebro do Designer ──
# O cérebro (regras globais, regra de foto real, trava de texto aprovado, revisão final) vale em TODO
# projeto, com ou sem ficha salva. A ficha só acrescenta a camada do projeto.
# SAÍDA DE EMERGÊNCIA: DESIGNER_BRAIN_GLOBAL=off devolve o comportamento anterior (o cérebro só liga com
# ficha salva ou com o slug em DESIGNER_BRAIN_BRANDS). Vale para a API (chat) e para o worker (geração):
# defina o MESMO valor nos dois e reinicie ambos. Aceita off, 0, false, no. Qualquer outro valor (ou vazio) = ligado.
# ATENÇÃO: a saída de emergência devolve o comportamento anterior, EXCETO neste ponto: mesmo com
# DESIGNER_BRAIN_GLOBAL=off, se a LEITURA da ficha do projeto falhar (banco fora, erro inesperado) a geração AINDA PARA
# com erro visível. Só tabela ou coluna inexistente (Prisma P2021/P2022, migrations parciais) segue como "sem ficha".
# DESIGNER_BRAIN_GLOBAL=off
# Só tem efeito com DESIGNER_BRAIN_GLOBAL=off: slugs (separados por vírgula) que ligam o cérebro sem ficha.
# DESIGNER_BRAIN_BRANDS=

# ── Teto de gasto de IA (tokens/dia; 0 = sem limite) ──
# AI_DAILY_TOKEN_BUDGET=20000000
# AI_BRAND_DAILY_TOKEN_BUDGET=5000000
# Teto de FOTOS/imagens GERADAS por deck (não conta reaproveitadas da biblioteca).
# MAX_GENERATED_IMAGES_PER_DECK=6

# ── Billing / transparência de gasto (tela Configurações → Gastos de IA) ──
# Preço por modelo em USD/1M tokens, JSON {"modelo":{"input":x,"output":y}}.
# AI_MODEL_PRICES=
# Preço de reserva p/ modelo fora da tabela (0 = não estima).
# AI_USD_PER_MILLION_TOKENS=0
# Câmbio para exibir em R$ (0 = mostra em US$).
# AI_USD_TO_BRL=0
# Alíquota de imposto exibida separada (fração; ex.: 0.0638 = IOF 6,38%).
# AI_TAX_RATE=0

# ── Resiliência das chamadas de IA ──
# AI_TIMEOUT_LIGHT_MS=25000       # timeout por tentativa, modelos flash
# AI_TIMEOUT_HEAVY_MS=150000      # timeout por tentativa, modelos pro
# AI_MAX_INFLIGHT_PER_MODEL=8     # chamadas simultâneas por modelo (AIMD ajusta)
# AI_RATE_LIMIT_RETRIES=6         # insistências no MESMO modelo em 429

# ── Filas / concorrência ──
# PIPELINE_CONCURRENCY=2          # gerações simultâneas por worker
# GENERATION_CONCURRENCY=2        # lotes paralelos DENTRO de uma geração
# RUN_WORKER_IN_PROCESS=true      # false = rode node dist/worker.js separado
# RASTER_CONCURRENCY=             # renders chromium simultâneos (default: pela RAM)

# ── Reviewer (QA visual da geração) ──
# REVIEWER_VISUAL=true            # false = só crítica textual (mais barato)
# REVIEWER_SAMPLE_SIZE=8          # slides amostrados (espalhados pelo deck)

# ── Cloudflare R2 (assets, exports, PPTX) ──
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# ── Canva Connect API (OAuth 2.0 + PKCE) ──
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://localhost:4000/api/canva/callback
# Chave opcional para criptografar tokens Canva no banco. Se omitida, deriva de JWT_SECRET.
# Em produção recomenda-se definir uma chave explícita e rotacioná-la com cuidado.
# CANVA_TOKEN_ENCRYPTION_KEY=

# ── Conector MCP do ChatGPT (docs/MCP-CHATGPT.md) ──
# Desligado por padrão: sem MCP_ENABLED=true nenhuma rota do conector existe.
# MCP_ENABLED=false
# Origem pública da API (https, sem path). Issuer e resource do OAuth derivam DAQUI —
# nunca do header Host. Obrigatória em produção; em dev cai em http://localhost:<PORT>.
# PUBLIC_BASE_URL=https://api.exemplo.com
# Origem do frontend (tela /mcp/consent). Padrão: primeiro valor de CORS_ORIGIN.
# FRONTEND_URL=https://app.exemplo.com
# redirect_uris aceitas no registro de clientes, separadas por vírgula. {id} casa UM segmento
# [A-Za-z0-9_-]{1,128}. Definir SUBSTITUI o padrão (os dois redirects do ChatGPT).
# MCP_ALLOWED_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect,https://chatgpt.com/connector/oauth/{id}
# Aceita redirect e Origin de loopback (MCP Inspector). SÓ para teste local.
# MCP_ALLOW_LOCALHOST_REDIRECT=false
# Origens extras aceitas no header Origin de /mcp (padrão: PUBLIC_BASE_URL e FRONTEND_URL).
# MCP_ALLOWED_ORIGINS=
# Teto de clientes registrados por DCR ao mesmo tempo.
# MCP_MAX_CLIENTS=500

# ── Logs ──
# LOG_LEVEL=info

# Login administrativo "rootSystem" (opcional; desligado sem o hash). Entra pelo /login com o nome abaixo
# e a senha, sem exigir domínio de e-mail. Guarda só o HASH bcrypt, nunca a senha.
# Gerar: ROOT_ADMIN_PASSWORD='...' pnpm exec tsx scripts/hashRootAdminPassword.ts
# ROOT_ADMIN_LOGIN=rootSystem
# ROOT_ADMIN_PASSWORD_HASH='$2b$12$...'
